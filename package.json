{
  "name": "fsl-std-cli",
  "version": "1.0.0",
  "description": "A command-line tool for quickly initializing frontend project standardization configurations",
  "bin": {
    "fstd": "dist/bin/entry.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev:watch": "tsc-watch --noClear -p ./tsconfig.json",
    "dev": "concurrently --kill-others \"pnpm dev:watch\" \"pnpm -r dev:watch\"",
    "commit": "npx git-cz",
    "precommit": "lint-staged",
    "generate-docs": "jsdoc --configure .jsdoc.json --verbose",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
    "link": "pnpm link --global",
    "upgrade": "pnpm up --latest -r"
  },
  "keywords": [],
  "author": "Chase Chen",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@commitlint/cli": "~19.8.1",
    "@commitlint/config-conventional": "~19.8.1",
    "@esbuild-kit/esm-loader": "^2.6.5",
    "@types/edit-json-file": "~1.7.3",
    "@types/figlet": "~1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.8",
    "@types/node": "^24.0.14",
    "autoprefixer": "~10.4.21",
    "better-docs": "~2.7.3",
    "commitizen": "~4.3.1",
    "commonjs-extension-resolution-loader": "^0.1.0",
    "concurrently": "^9.2.0",
    "conventional-changelog": "~7.1.1",
    "conventional-changelog-cli": "~5.0.0",
    "cz-conventional-changelog": "~3.3.0",
    "edit-json-file": "~1.8.1",
    "husky": "~9.1.7",
    "jsdoc": "~4.0.4",
    "lint-staged": "~16.1.2",
    "prettier": "~3.6.2",
    "taffydb": "~2.7.3",
    "tsc-watch": "^7.1.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@fsl-std-cli/script": "workspace:*",
    "@fsl-std-cli/template": "workspace:*",
    "@inquirer/prompts": "~7.6.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "figlet": "~1.8.2",
    "fs-extra": "^11.3.0",
    "fsl-std-cli": "link:",
    "node-fetch": "^3.3.2",
    "ora": "^8.2.0"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "npm run precommit"
    }
  },
  "lint-staged.editor/**/*\\.{tsx,ts,jsx,js}": [
    "pnpm exec biome format --write",
    "git add"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "pnpm": {
    "overrides": {
      "fsl-std-cli": "link:"
    }
  }
}
